# Copy to .env and replace both passwords, or run:
# powershell -NoProfile -File scripts/local.ps1 Init
# The helper generates distinct random passwords without printing them.
# This file is for LOCAL Docker MySQL only. Never add provider keys here.
DB_NAME=spring_ai
DB_USERNAME=spring_ai_app
DB_PORT=3307
DB_PASSWORD=replace_with_a_long_random_alphanumeric_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_alphanumeric_password
