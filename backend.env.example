# Local backend runtime settings. Init creates ignored .env.backend from this file.
# The application key stays on the backend and development proxy, never in browser code.
AZURE_OPENAI_BASE_URL=https://anthropic-agent.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
CHAT_API_KEY=replace_with_generated_application_key
# Supply AZURE_OPENAI_API_KEY in the terminal before BackendUp; do not add it here.
